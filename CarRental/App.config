<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
            <section name="CarRental.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false"/>
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
    </startup>
    <userSettings>
        <CarRental.Properties.Settings>
            <setting name="Language" serializeAs="String">
                <value>en</value>
            </setting>
            <setting name="MainColor" serializeAs="String">
                <value>SteelBlue</value>
            </setting>
        </CarRental.Properties.Settings>
    </userSettings>
	<connectionStrings>
		<add name="CarRentalConnection" connectionString="Server=.;Database=CarRental;User=sa;Password=sa123456"/>
		<add name="MasterConnection" connectionString="Server=.;Database=master;Trusted_Connection=true"/>
	</connectionStrings>
</configuration>
